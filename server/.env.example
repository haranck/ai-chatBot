PORT=3000

# MongoDB Atlas connection string: put your real password (no < >) and a database name
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pseudo-ai

# Groq (free tier) - https://console.groq.com/keys
GROQ_API_KEY=
# Optional, default is openai/gpt-oss-20b (fastest); the other gpt-oss model is used automatically when it hits its limit
# GROQ_MODEL=openai/gpt-oss-20b

# Google Cloud Console > APIs & Services > Credentials (same ID as the client)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Random secrets, generate each with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional: extra allowed client origins, comma-separated
# CLIENT_ORIGINS=https://my-other-domain.com

# Set on your hosting provider so the refresh cookie works across sites (Secure + SameSite=None)
# NODE_ENV=production
